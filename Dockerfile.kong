# upstream: none Kong gateway image that the Kortix stack runs on, not the Kortix app
FROM kong/kong:3.9.1@sha256:6addf50e6bd8d578314cb9ce4f2d2d1e3781d2edecef59f707e00c6e05d384f5

COPY assets/kong/ /opt/kortix/kong/
ENV KORTIX_ROLE=kong \
    KONG_DATABASE=off \
    KONG_DECLARATIVE_CONFIG=/usr/local/kong/kong.yml \
    KONG_ROUTER_FLAVOR=expressions \
    KONG_DNS_NOT_FOUND_TTL=1 \
    KONG_PLUGINS=request-transformer,cors,key-auth,acl,basic-auth,request-termination,ip-restriction,post-function \
    KONG_NGINX_PROXY_PROXY_BUFFER_SIZE=160k \
    "KONG_NGINX_PROXY_PROXY_BUFFERS=64 160k" \
    "KONG_PROXY_ACCESS_LOG=/dev/stdout combined" \
    KONG_NGINX_WORKER_PROCESSES=2
COPY railway-boot.sh /usr/local/bin/railway-boot.sh
RUN chmod 755 /usr/local/bin/railway-boot.sh
ENTRYPOINT ["/bin/sh", "/usr/local/bin/railway-boot.sh"]
