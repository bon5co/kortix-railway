# upstream: none PostgREST image that the Kortix stack runs on, not the Kortix app
FROM postgrest/postgrest:v14.12@sha256:54000f24847d01a2c2302e0041cf0618b875c57fb48507d743cfa9aaa50bf43c

# PostgREST's image has no shell, so it is configured entirely by these ENV values and the template's expression variables.
ENV PGRST_SERVER_HOST=:: \
    PGRST_SERVER_PORT=3000 \
    PGRST_DB_SCHEMAS=public \
    PGRST_DB_MAX_ROWS=1000 \
    PGRST_DB_EXTRA_SEARCH_PATH=public \
    PGRST_DB_ANON_ROLE=anon \
    PGRST_ADMIN_SERVER_PORT=3001 \
    PGRST_ADMIN_SERVER_HOST=localhost \
    PGRST_DB_USE_LEGACY_GUCS=false \
    PGRST_APP_SETTINGS_JWT_EXP=3600
