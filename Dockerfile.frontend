# upstream: kortix-ai/suna
FROM kortix/kortix-frontend:0.16.4@sha256:aac0d9a594bf8262f2e9429f26a77736214e399fcfacab90a45cb3202ae628ff

ENV KORTIX_ROLE=frontend \
    HOSTNAME=0.0.0.0 \
    KORTIX_PUBLIC_BILLING_ENABLED=false \
    KORTIX_PUBLIC_RESTRICT_ACCOUNT_CREATION=true \
    KORTIX_PUBLIC_DISABLE_LANDING_PAGE=true \
    NODE_OPTIONS=--max-http-header-size=131072
COPY --chmod=755 railway-boot.sh /usr/local/bin/railway-boot.sh
ENTRYPOINT ["/bin/sh", "/usr/local/bin/railway-boot.sh"]
